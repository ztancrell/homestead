# The D-Bus session bus starts (OpenRC user service) before X, so services it starts (xdg-desktop-portal-gtk:
# file dialogs for Steam, Firefox, Flatpaks) had no DISPLAY and exited. Hand them the session's environment.
dbus-update-activation-environment DISPLAY XAUTHORITY XDG_SESSION_TYPE QT_QPA_PLATFORMTHEME XCURSOR_THEME XCURSOR_SIZE

# obmenu-generator has no system config.pl and would write xterm defaults: start from Homestead's
[ -d ~/.config/obmenu-generator ] || cp -r /etc/xdg/obmenu-generator ~/.config/obmenu-generator

# polkit agent (if present)
/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &

# login sound
paplay /usr/share/homestead/sounds/desktop-login.oga >/dev/null 2>&1 &

# USB plug/unplug sounds
bash /usr/share/homestead/scripts/device-monitor.sh >/dev/null 2>&1 &

# compositor (fastcompmgr-homestead)
/usr/bin/fastcompmgr &
sleep 1

# wallpaper (FIXED: removed trailing '>')
feh --bg-fill --randomize -r /usr/share/backgrounds/homestead

# tint2 and dunst
tint2 -c "${HOMESTEAD_TINT2RC:-/etc/xdg/tint2/tint2rc}" &
dunst &

# XDG autostart (/etc/xdg/autostart, ~/.config/autostart): nm-applet, blueman-applet, pasystray and the like.
# openbox-autostart's own openbox-xdg-autostart needs python-pyxdg, which isn't installed, so it runs nothing;
# dex honours OnlyShowIn/NotShowIn and Hidden=true. After tint2 so the tray is up when the applets dock.
sleep 1
dex -a -e Openbox &
