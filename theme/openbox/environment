#
# Set system-wide environment variables here for Openbox
# User-specific variables should be placed in $HOME/.config/openbox/environment
#

# To set your language for displaying messages and time/date formats, use the following:
#LANG=en_CA.UTF8

# To set your keyboard layout, you need to modify your X config:
# http://www.google.com/search?q=how+to+set+keyboard+layout+xorg

# Homestead cursor (Artix's default-cursors owns /usr/share/icons/default and points it at Adwaita)
export XCURSOR_THEME=Homestead-Cursor
export XCURSOR_SIZE=${XCURSOR_SIZE:-24}

# Qt follows the GTK theme. Artix's /etc/environment sets QT_QPA_PLATFORMTHEME and QT_STYLE_OVERRIDE to
# gtk4, which is no Qt plugin, so Qt fell back to light Fusion. Qt 5 and 6 both ship the gtk3 platform theme.
export QT_QPA_PLATFORMTHEME=gtk3
unset QT_STYLE_OVERRIDE
